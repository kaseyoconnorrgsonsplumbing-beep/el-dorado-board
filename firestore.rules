rules_version = '2';
// El Dorado room-progress board rules.
// NOTE: this app has no login, so these rules are what protect the data.
// Below is OPEN read/write to the El Dorado collections only (matches how
// the existing field apps run). Tighten before sharing the URL widely.
service cloud.firestore {
  match /databases/{database}/documents {

    // El Dorado config (legacy single board — kept for migration)
    match /eldorado_config/{doc} {
      allow read, write: if true;
    }

    // Projects (each doc holds one project's config)
    match /eldorado_projects/{project} {
      allow read, write: if true;
    }

    // El Dorado per-room progress
    match /eldorado_rooms/{room} {
      allow read, write: if true;
    }

    // El Dorado users (name, company, password, approval status)
    match /eldorado_users/{user} {
      allow read, write: if true;
    }

    // El Dorado activity log (append-only in practice)
    match /eldorado_log/{entry} {
      allow read, write: if true;
    }
    match /eldorado_materials/{req} {
      allow read, write: if true;
    }

    // ---- Leave your existing collections (e.g. tickets) governed by their
    // ---- own rules. Do not widen anything else here.
  }
}
